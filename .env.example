# ==========================================
# Telegram Bot Configuration
# ==========================================
# Token from BotFather. This is the name the app reads.
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Optional old name. Used only when TELEGRAM_BOT_TOKEN is empty.
# BOT_TOKEN=
ADMIN_TELEGRAM_ID=123456789
BOT_NAME=TravelPayBot
# Public username without @. Landing t.me links and mentions read this.
# Rename the bot in BotFather, then change only this value.
BOT_USERNAME=TravelPaymentsGuideBot
WEBHOOK_SECRET=your_secret_random_string

# ==========================================
# Supabase Configuration
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# ==========================================
# Telethon (MTProto Telegram Client)
# ==========================================
# Get api_id & api_hash from https://my.telegram.org
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
# Authorize once and export StringSession string for headless server deployment
TELETHON_SESSION_STRING=

# ==========================================
# Data Sources & Fallbacks
# ==========================================
RSHB_UNIONPAY_URL=https://www.rshb.ru/natural/cards/tariffs/unionpay

# ==========================================
# Unused at launch: all countries are free, Stars invoices are rejected.
# ==========================================
STARS_PRICE_90_DAYS=150

# ==========================================
# Telegram Mini App
# ==========================================
# Public https URL of the hosted app, with a trailing slash.
# BotFather → Menu Button and the bot's Open button use this.
# Example: https://<project>.vercel.app/miniapp/
MINIAPP_URL=https://your-project.vercel.app/miniapp/
# Local browser only. Never set this on Vercel: it trusts initData "dev:<telegram id>".
MINIAPP_DEV_AUTH=0
# Reject Telegram initData older than this many seconds (default 1 day).
MINIAPP_INITDATA_MAX_AGE_SECONDS=86400
