{
  "version": 2,
  "redirects": [
    {
      "source": "/miniapp",
      "destination": "/miniapp/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py?path=:path*"
    },
    {
      "source": "/((?!api/|miniapp/).*)",
      "destination": "/landing/index.html"
    }
  ]
}
